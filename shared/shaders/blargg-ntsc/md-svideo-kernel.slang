#version 450

/*
   Blargg's NTSC filter: the kernels of Genesis Plus GX's "S-Video".

   md_ntsc 0.1.2, Copyright (C) 2006-2007 Shay Green, GNU Lesser General Public
   License, version 2.1 or later. Written by
   shared/shaders/tools/blargg_ntsc.py; change that, not this.

   One row per burst phase (1), place of the pixel against the colour
   carrier (2) and input channel (red, green, blue): what a pixel with
   that channel at 1 adds to the 16 output samples it spreads over. A column
   of zeroes either side lets blargg-ntsc.inc read between samples.
*/

layout(push_constant) uniform Push
{
    vec4 OutputSize;
} params;

layout(std140, set = 0, binding = 0) uniform UBO
{
    mat4 MVP;
} global;

#pragma stage vertex
layout(location = 0) in vec4 Position;
layout(location = 1) in vec2 TexCoord;
layout(location = 0) out vec2 vTexCoord;

void main()
{
    gl_Position = global.MVP * Position;
    vTexCoord = TexCoord;
}

#pragma stage fragment
#pragma format R16G16B16A16_SFLOAT
layout(location = 0) in vec2 vTexCoord;
layout(location = 0) out vec4 FragColor;

const int kTaps = 16;
const int kRows = 6;

const vec3 kKernel[kRows * kTaps] = vec3[kRows * kTaps](
    // burst 0, pixel 0, red
    vec3(0.035406, -0.016088, -0.009530),
    vec3(0.064541, -0.010227, -0.002089),
    vec3(0.073548, -0.028643, -0.019477),
    vec3(0.063890, -0.067573, -0.058337),
    vec3(0.101980, -0.057197, -0.049155),
    vec3(0.228044, 0.046666, 0.052259),
    vec3(0.358159, 0.163660, 0.165840),
    vec3(0.359818, 0.163566, 0.161980),
    vec3(0.232726, 0.046399, 0.041364),
    vec3(0.108848, -0.057588, -0.065136),
    vec3(0.071846, -0.068026, -0.076850),
    vec3(0.081482, -0.029095, -0.037939),
    vec3(0.071607, -0.010629, -0.018529),
    vec3(0.041112, -0.016413, -0.022806),
    vec3(0.020924, -0.016927, -0.021667),
    vec3(0.015964, -0.007459, -0.010695),
    // burst 0, pixel 0, green
    vec3(-0.032314, 0.024324, -0.039610),
    vec3(-0.020983, 0.060156, -0.030001),
    vec3(-0.057252, 0.052097, -0.067353),
    vec3(-0.133686, 0.004959, -0.143774),
    vec3(-0.113182, 0.052202, -0.121827),
    vec3(0.090996, 0.276617, 0.085205),
    vec3(0.321063, 0.517085, 0.319195),
    vec3(0.321297, 0.516087, 0.323716),
    vec3(0.091657, 0.273800, 0.097967),
    vec3(-0.112212, 0.048070, -0.103108),
    vec3(-0.132562, 0.000172, -0.122091),
    vec3(-0.056131, 0.047323, -0.045729),
    vec3(-0.019985, 0.055905, -0.010744),
    vec3(-0.031508, 0.020891, -0.024059),
    vec3(-0.032701, 0.001354, -0.027193),
    vec3(-0.014282, 0.006552, -0.010529),
    // burst 0, pixel 0, blue
    vec3(-0.002920, -0.008064, 0.049311),
    vec3(0.000084, -0.006287, 0.075732),
    vec3(-0.006441, -0.013598, 0.096685),
    vec3(-0.021261, -0.028443, 0.111054),
    vec3(-0.017904, -0.024111, 0.141875),
    vec3(0.020480, 0.016236, 0.202055),
    vec3(0.063398, 0.061874, 0.257584),
    vec3(0.061505, 0.062966, 0.256923),
    vec3(0.015136, 0.019320, 0.200189),
    vec3(-0.025743, -0.019588, 0.139137),
    vec3(-0.030341, -0.023203, 0.107883),
    vec3(-0.015496, -0.008373, 0.093523),
    vec3(-0.007980, -0.001634, 0.072916),
    vec3(-0.009432, -0.004306, 0.047037),
    vec3(-0.008805, -0.005010, 0.028277),
    vec3(-0.004449, -0.001860, 0.018458),
    // burst 0, pixel 1, red
    vec3(0.035406, -0.016088, -0.009530),
    vec3(0.064541, -0.010227, -0.002089),
    vec3(0.073548, -0.028643, -0.019477),
    vec3(0.063890, -0.067573, -0.058337),
    vec3(0.101980, -0.057197, -0.049155),
    vec3(0.228044, 0.046666, 0.052259),
    vec3(0.392391, 0.150836, 0.155087),
    vec3(0.396546, 0.141414, 0.145987),
    vec3(0.266959, 0.033574, 0.030610),
    vec3(0.145577, -0.079740, -0.081129),
    vec3(0.071846, -0.068026, -0.076850),
    vec3(0.081482, -0.029095, -0.037939),
    vec3(0.071607, -0.010629, -0.018529),
    vec3(0.041112, -0.016413, -0.022806),
    vec3(0.020924, -0.016927, -0.021667),
    vec3(0.015964, -0.007459, -0.010695),
    // burst 0, pixel 1, green
    vec3(-0.032314, 0.024324, -0.039610),
    vec3(-0.020983, 0.060156, -0.030001),
    vec3(-0.057252, 0.052097, -0.067353),
    vec3(-0.133686, 0.004959, -0.143774),
    vec3(-0.113182, 0.052202, -0.121827),
    vec3(0.090996, 0.276617, 0.085205),
    vec3(0.295656, 0.540327, 0.291581),
    vec3(0.277123, 0.535613, 0.272724),
    vec3(0.066250, 0.297042, 0.070353),
    vec3(-0.156386, 0.067596, -0.154099),
    vec3(-0.132562, 0.000172, -0.122091),
    vec3(-0.056131, 0.047323, -0.045729),
    vec3(-0.019985, 0.055905, -0.010744),
    vec3(-0.031508, 0.020891, -0.024059),
    vec3(-0.032701, 0.001354, -0.027193),
    vec3(-0.014282, 0.006552, -0.010529),
    // burst 0, pixel 1, blue
    vec3(-0.002920, -0.008064, 0.049311),
    vec3(0.000084, -0.006287, 0.075732),
    vec3(-0.006441, -0.013598, 0.096685),
    vec3(-0.021261, -0.028443, 0.111054),
    vec3(-0.017904, -0.024111, 0.141875),
    vec3(0.020480, 0.016236, 0.202055),
    vec3(0.059511, 0.056395, 0.300891),
    vec3(0.056072, 0.052715, 0.311031),
    vec3(0.011249, 0.013841, 0.243495),
    vec3(-0.031175, -0.029839, 0.193245),
    vec3(-0.030341, -0.023203, 0.107883),
    vec3(-0.015496, -0.008373, 0.093523),
    vec3(-0.007980, -0.001634, 0.072916),
    vec3(-0.009432, -0.004306, 0.047037),
    vec3(-0.008805, -0.005010, 0.028277),
    vec3(-0.004449, -0.001860, 0.018458)
);

void main()
{
    ivec2 texel = ivec2(floor(vTexCoord * params.OutputSize.xy));
    int tap = texel.x - 1;
    vec3 k = vec3(0.0);
    if (tap >= 0 && tap < kTaps && texel.y >= 0 && texel.y < kRows)
        k = kKernel[texel.y * kTaps + tap];
    FragColor = vec4(k, 1.0);
}
