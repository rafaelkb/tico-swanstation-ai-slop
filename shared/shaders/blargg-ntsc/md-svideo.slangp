# Blargg's NTSC filter: Genesis Plus GX's "S-Video" (md_ntsc 0.1.2, Shay Green,
# LGPL 2.1 or later). Written by shared/shaders/tools/blargg_ntsc.py.

shaders = 2

# The kernels, as a texture: 16 taps and a zero either side, by
# 1 burst phase(s) x 2 pixel places x 3 input channels. The filter
# of this pass is the one the next reads the game with ("Original"): linear,
# which averages the pixels of a higher internal resolution.
shader0 = md-svideo-kernel.slang
filter_linear0 = true
scale_type0 = absolute
scale_x0 = 18
scale_y0 = 6

# The picture: every pixel of the game through its kernel.
shader1 = md.slang
filter_linear1 = true
scale_type1 = viewport
