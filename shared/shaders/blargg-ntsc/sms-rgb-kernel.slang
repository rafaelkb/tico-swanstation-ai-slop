#version 450

/*
   Blargg's NTSC filter: the kernels of Genesis Plus GX's "RGB".

   sms_ntsc 0.2.3, Copyright (C) 2006-2007 Shay Green, GNU Lesser General Public
   License, version 2.1 or later. Written by
   shared/shaders/tools/blargg_ntsc.py; change that, not this.

   One row per burst phase (1), place of the pixel against the colour
   carrier (3) and input channel (red, green, blue): what a pixel with
   that channel at 1 adds to the 14 output samples it spreads over. A column
   of zeroes either side lets blargg-ntsc.inc read between samples.
*/

layout(push_constant) uniform Push
{
    vec4 OutputSize;
} params;

layout(std140, set = 0, binding = 0) uniform UBO
{
    mat4 MVP;
} global;

#pragma stage vertex
layout(location = 0) in vec4 Position;
layout(location = 1) in vec2 TexCoord;
layout(location = 0) out vec2 vTexCoord;

void main()
{
    gl_Position = global.MVP * Position;
    vTexCoord = TexCoord;
}

#pragma stage fragment
#pragma format R16G16B16A16_SFLOAT
layout(location = 0) in vec2 vTexCoord;
layout(location = 0) out vec4 FragColor;

const int kTaps = 14;
const int kRows = 9;

const vec3 kKernel[kRows * kTaps] = vec3[kRows * kTaps](
    // burst 0, pixel 0, red
    vec3(0.002387, 0.002387, 0.002387),
    vec3(-0.001463, -0.001463, -0.001463),
    vec3(-0.003588, -0.003608, -0.003621),
    vec3(0.006906, 0.003127, 0.000600),
    vec3(0.103481, -0.044888, -0.140358),
    vec3(0.602844, -0.006176, -0.242509),
    vec3(0.931224, 0.071328, 0.023799),
    vec3(0.699110, 0.019093, -0.023868),
    vec3(0.255665, -0.039726, -0.185736),
    vec3(-0.006384, -0.014956, -0.020643),
    vec3(0.003158, 0.003080, 0.003026),
    vec3(-0.001548, -0.001548, -0.001548),
    vec3(-0.000051, -0.000051, -0.000051),
    vec3(-0.000290, -0.000290, -0.000290),
    // burst 0, pixel 0, green
    vec3(0.004687, 0.004687, 0.004687),
    vec3(-0.002872, -0.002872, -0.002872),
    vec3(-0.007081, -0.007072, -0.007066),
    vec3(0.006421, 0.008193, 0.009305),
    vec3(-0.077479, -0.004919, 0.031534),
    vec3(0.014235, 0.435339, 0.284854),
    vec3(0.145354, 0.966688, 0.202093),
    vec3(0.042291, 0.687555, 0.093271),
    vec3(-0.061707, 0.117671, 0.105232),
    vec3(-0.028728, -0.024671, -0.022236),
    vec3(0.006052, 0.006088, 0.006113),
    vec3(-0.003038, -0.003038, -0.003038),
    vec3(-0.000101, -0.000101, -0.000101),
    vec3(-0.000569, -0.000569, -0.000569),
    // burst 0, pixel 0, blue
    vec3(0.000910, 0.000910, 0.000910),
    vec3(-0.000558, -0.000558, -0.000558),
    vec3(-0.001382, -0.001371, -0.001364),
    vec3(-0.000055, 0.001951, 0.003366),
    vec3(-0.064243, 0.011566, 0.070583),
    vec3(-0.119115, 0.068801, 0.455619),
    vec3(0.003427, 0.041989, 0.854114),
    vec3(-0.014167, 0.020587, 0.657832),
    vec3(-0.087251, 0.028762, 0.187211),
    vec3(-0.008509, -0.003994, -0.000743),
    vec3(0.001148, 0.001190, 0.001219),
    vec3(-0.000590, -0.000590, -0.000590),
    vec3(-0.000020, -0.000020, -0.000020),
    vec3(-0.000110, -0.000110, -0.000110),
    // burst 0, pixel 1, red
    vec3(-0.000853, -0.000853, -0.000853),
    vec3(0.000528, 0.000528, 0.000528),
    vec3(-0.001464, -0.001484, -0.001497),
    vec3(0.001585, -0.000901, -0.002514),
    vec3(0.056172, -0.025317, -0.072066),
    vec3(0.289913, -0.029323, 0.012570),
    vec3(0.762355, 0.060317, 0.202129),
    vec3(0.886283, 0.053260, -0.086220),
    vec3(0.326373, -0.031399, -0.072263),
    vec3(0.014900, -0.022966, 0.023964),
    vec3(0.000161, -0.000820, 0.000798),
    vec3(-0.001476, -0.001483, -0.001470),
    vec3(0.000528, 0.000528, 0.000528),
    vec3(-0.000853, -0.000853, -0.000853),
    // burst 0, pixel 1, green
    vec3(-0.001675, -0.001675, -0.001675),
    vec3(0.001036, 0.001036, 0.001036),
    vec3(-0.002911, -0.002902, -0.002896),
    vec3(-0.001589, -0.000384, 0.000253),
    vec3(-0.044489, -0.000131, 0.008920),
    vec3(-0.062227, 0.289873, -0.108857),
    vec3(0.102628, 0.916311, -0.056408),
    vec3(0.120132, 0.841755, 0.281333),
    vec3(-0.057077, 0.267938, -0.009492),
    vec3(-0.050318, 0.024699, -0.103558),
    vec3(-0.001790, 0.000473, -0.003627),
    vec3(-0.002913, -0.002895, -0.002928),
    vec3(0.001036, 0.001036, 0.001036),
    vec3(-0.001675, -0.001675, -0.001675),
    // burst 0, pixel 1, blue
    vec3(-0.000325, -0.000325, -0.000325),
    vec3(0.000201, 0.000201, 0.000201),
    vec3(-0.000572, -0.000562, -0.000554),
    vec3(-0.001140, 0.000141, 0.001117),
    vec3(-0.032734, 0.004397, 0.042096),
    vec3(0.009351, -0.023513, 0.333323),
    vec3(0.092644, -0.019001, 0.811906),
    vec3(-0.048788, 0.062612, 0.762514),
    vec3(-0.032259, 0.000498, 0.318792),
    vec3(0.014368, -0.022782, 0.058545),
    vec3(0.000485, -0.000796, 0.001685),
    vec3(-0.000559, -0.000569, -0.000550),
    vec3(0.000201, 0.000201, 0.000201),
    vec3(-0.000325, -0.000325, -0.000325),
    // burst 0, pixel 2, red
    vec3(-0.000290, -0.000290, -0.000290),
    vec3(-0.000051, -0.000051, -0.000051),
    vec3(-0.001548, -0.001548, -0.001548),
    vec3(0.003814, 0.003785, 0.003838),
    vec3(-0.011676, -0.014944, -0.009239),
    vec3(0.126433, -0.032656, 0.114044),
    vec3(0.661076, 0.022001, 0.066965),
    vec3(0.885347, 0.070900, 0.120972),
    vec3(0.395940, 0.007724, 0.245571),
    vec3(0.016344, -0.042967, 0.052818),
    vec3(0.004676, 0.003254, 0.005788),
    vec3(-0.003600, -0.003607, -0.003593),
    vec3(-0.001463, -0.001463, -0.001463),
    vec3(0.002387, 0.002387, 0.002387),
    // burst 0, pixel 2, green
    vec3(-0.000569, -0.000569, -0.000569),
    vec3(-0.000101, -0.000101, -0.000101),
    vec3(-0.003038, -0.003038, -0.003038),
    vec3(0.007424, 0.007496, 0.007363),
    vec3(-0.029974, -0.022189, -0.036449),
    vec3(-0.080458, 0.194717, -0.246755),
    vec3(0.038199, 0.712238, -0.010920),
    vec3(0.133633, 0.986910, 0.079256),
    vec3(-0.011338, 0.564955, -0.280549),
    vec3(-0.095028, 0.040125, -0.203749),
    vec3(0.006106, 0.009535, 0.003228),
    vec3(-0.007083, -0.007065, -0.007098),
    vec3(-0.002872, -0.002872, -0.002872),
    vec3(0.004687, 0.004687, 0.004687),
    // burst 0, pixel 2, blue
    vec3(-0.000110, -0.000110, -0.000110),
    vec3(-0.000020, -0.000020, -0.000020),
    vec3(-0.000590, -0.000590, -0.000590),
    vec3(0.001469, 0.001427, 0.001506),
    vec3(-0.002886, -0.007403, 0.001153),
    vec3(0.059818, -0.056268, 0.238504),
    vec3(0.030309, -0.004655, 0.673539),
    vec3(0.051403, 0.012574, 0.870155),
    vec3(0.120064, -0.068012, 0.539645),
    vec3(0.030821, -0.045021, 0.103068),
    vec3(0.002490, 0.000483, 0.004255),
    vec3(-0.001369, -0.001379, -0.001359),
    vec3(-0.000558, -0.000558, -0.000558),
    vec3(0.000910, 0.000910, 0.000910)
);

void main()
{
    ivec2 texel = ivec2(floor(vTexCoord * params.OutputSize.xy));
    int tap = texel.x - 1;
    vec3 k = vec3(0.0);
    if (tap >= 0 && tap < kTaps && texel.y >= 0 && texel.y < kRows)
        k = kKernel[texel.y * kTaps + tap];
    FragColor = vec4(k, 1.0);
}
