#version 450

/*
   Blargg's NTSC filter: the kernels of Genesis Plus GX's "RGB".

   md_ntsc 0.1.2, Copyright (C) 2006-2007 Shay Green, GNU Lesser General Public
   License, version 2.1 or later. Written by
   shared/shaders/tools/blargg_ntsc.py; change that, not this.

   One row per burst phase (1), place of the pixel against the colour
   carrier (2) and input channel (red, green, blue): what a pixel with
   that channel at 1 adds to the 16 output samples it spreads over. A column
   of zeroes either side lets blargg-ntsc.inc read between samples.
*/

layout(push_constant) uniform Push
{
    vec4 OutputSize;
} params;

layout(std140, set = 0, binding = 0) uniform UBO
{
    mat4 MVP;
} global;

#pragma stage vertex
layout(location = 0) in vec4 Position;
layout(location = 1) in vec2 TexCoord;
layout(location = 0) out vec2 vTexCoord;

void main()
{
    gl_Position = global.MVP * Position;
    vTexCoord = TexCoord;
}

#pragma stage fragment
#pragma format R16G16B16A16_SFLOAT
layout(location = 0) in vec2 vTexCoord;
layout(location = 0) out vec4 FragColor;

const int kTaps = 16;
const int kRows = 6;

const vec3 kKernel[kRows * kTaps] = vec3[kRows * kTaps](
    // burst 0, pixel 0, red
    vec3(0.003176, 0.003176, 0.003176),
    vec3(-0.000270, -0.000270, -0.000270),
    vec3(-0.007610, -0.007626, -0.007637),
    vec3(0.014521, 0.013011, 0.012118),
    vec3(0.009116, -0.032425, -0.048403),
    vec3(0.158277, -0.046042, 0.121395),
    vec3(0.679160, 0.080545, 0.263737),
    vec3(0.839662, 0.071406, -0.109710),
    vec3(0.305434, -0.054421, -0.221001),
    vec3(-0.005008, -0.031621, -0.015540),
    vec3(0.013733, 0.013056, 0.013952),
    vec3(-0.007620, -0.007626, -0.007615),
    vec3(-0.000270, -0.000270, -0.000270),
    vec3(0.003176, 0.003176, 0.003176),
    vec3(-0.003472, -0.003472, -0.003472),
    vec3(0.001513, 0.001513, 0.001513),
    // burst 0, pixel 0, green
    vec3(0.006236, 0.006236, 0.006236),
    vec3(-0.000530, -0.000530, -0.000530),
    vec3(-0.014970, -0.014963, -0.014958),
    vec3(0.025642, 0.026444, 0.026662),
    vec3(-0.061875, -0.033038, -0.043578),
    vec3(-0.109047, 0.227743, -0.298779),
    vec3(0.137725, 0.880884, -0.068684),
    vec3(0.160395, 0.784324, 0.368732),
    vec3(-0.088262, 0.139212, 0.102267),
    vec3(-0.063870, -0.024541, -0.082071),
    vec3(0.025531, 0.026918, 0.024514),
    vec3(-0.014972, -0.014957, -0.014984),
    vec3(-0.000530, -0.000530, -0.000530),
    vec3(0.006236, 0.006236, 0.006236),
    vec3(-0.006817, -0.006817, -0.006817),
    vec3(0.002970, 0.002970, 0.002970),
    // burst 0, pixel 0, blue
    vec3(0.001211, 0.001211, 0.001211),
    vec3(-0.000103, -0.000103, -0.000103),
    vec3(-0.002913, -0.002904, -0.002899),
    vec3(0.004520, 0.005229, 0.005903),
    vec3(-0.020257, -0.007552, 0.018966),
    vec3(0.064921, -0.067551, 0.291535),
    vec3(0.120799, -0.023746, 0.742630),
    vec3(-0.062373, 0.081954, 0.678661),
    vec3(-0.103021, 0.029360, 0.232885),
    vec3(-0.004138, -0.016853, 0.024595),
    vec3(0.005419, 0.004710, 0.006218),
    vec3(-0.002902, -0.002911, -0.002895),
    vec3(-0.000103, -0.000103, -0.000103),
    vec3(0.001211, 0.001211, 0.001211),
    vec3(-0.001324, -0.001324, -0.001324),
    vec3(0.000577, 0.000577, 0.000577),
    // burst 0, pixel 1, red
    vec3(0.003176, 0.003176, 0.003176),
    vec3(-0.000270, -0.000270, -0.000270),
    vec3(-0.007610, -0.007626, -0.007637),
    vec3(0.014521, 0.013011, 0.012118),
    vec3(0.009116, -0.032425, -0.048403),
    vec3(0.158277, -0.046042, 0.121395),
    vec3(0.680321, 0.081707, 0.264899),
    vec3(0.835838, 0.067582, -0.113534),
    vec3(0.306595, -0.053260, -0.219839),
    vec3(-0.008831, -0.035445, -0.019363),
    vec3(0.013733, 0.013056, 0.013952),
    vec3(-0.007620, -0.007626, -0.007615),
    vec3(-0.000270, -0.000270, -0.000270),
    vec3(0.003176, 0.003176, 0.003176),
    vec3(-0.003472, -0.003472, -0.003472),
    vec3(0.001513, 0.001513, 0.001513),
    // burst 0, pixel 1, green
    vec3(0.006236, 0.006236, 0.006236),
    vec3(-0.000530, -0.000530, -0.000530),
    vec3(-0.014970, -0.014963, -0.014958),
    vec3(0.025642, 0.026444, 0.026662),
    vec3(-0.061875, -0.033038, -0.043578),
    vec3(-0.109047, 0.227743, -0.298779),
    vec3(0.140005, 0.883164, -0.066404),
    vec3(0.152888, 0.776817, 0.361226),
    vec3(-0.085982, 0.141492, 0.104547),
    vec3(-0.071377, -0.032048, -0.089578),
    vec3(0.025531, 0.026918, 0.024514),
    vec3(-0.014972, -0.014957, -0.014984),
    vec3(-0.000530, -0.000530, -0.000530),
    vec3(0.006236, 0.006236, 0.006236),
    vec3(-0.006817, -0.006817, -0.006817),
    vec3(0.002970, 0.002970, 0.002970),
    // burst 0, pixel 1, blue
    vec3(0.001211, 0.001211, 0.001211),
    vec3(-0.000103, -0.000103, -0.000103),
    vec3(-0.002913, -0.002904, -0.002899),
    vec3(0.004520, 0.005229, 0.005903),
    vec3(-0.020257, -0.007552, 0.018966),
    vec3(0.064921, -0.067551, 0.291535),
    vec3(0.121242, -0.023303, 0.743073),
    vec3(-0.063830, 0.080496, 0.677203),
    vec3(-0.102578, 0.029803, 0.233328),
    vec3(-0.005595, -0.018311, 0.023137),
    vec3(0.005419, 0.004710, 0.006218),
    vec3(-0.002902, -0.002911, -0.002895),
    vec3(-0.000103, -0.000103, -0.000103),
    vec3(0.001211, 0.001211, 0.001211),
    vec3(-0.001324, -0.001324, -0.001324),
    vec3(0.000577, 0.000577, 0.000577)
);

void main()
{
    ivec2 texel = ivec2(floor(vTexCoord * params.OutputSize.xy));
    int tap = texel.x - 1;
    vec3 k = vec3(0.0);
    if (tap >= 0 && tap < kTaps && texel.y >= 0 && texel.y < kRows)
        k = kKernel[texel.y * kTaps + tap];
    FragColor = vec4(k, 1.0);
}
