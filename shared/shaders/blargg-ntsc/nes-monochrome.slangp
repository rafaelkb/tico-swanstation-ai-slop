# Blargg's NTSC filter: FCEUmm's "Monochrome" (nes_ntsc 0.2.2, Shay Green,
# LGPL 2.1 or later). Written by shared/shaders/tools/blargg_ntsc.py.

shaders = 2

# The kernels, as a texture: 14 taps and a zero either side, by
# 3 burst phase(s) x 3 pixel places x 3 input channels. The filter
# of this pass is the one the next reads the game with ("Original"): linear,
# which averages the pixels of a higher internal resolution.
shader0 = nes-monochrome-kernel.slang
filter_linear0 = true
scale_type0 = absolute
scale_x0 = 16
scale_y0 = 27

# The picture: every pixel of the game through its kernel.
shader1 = nes.slang
filter_linear1 = true
scale_type1 = viewport
