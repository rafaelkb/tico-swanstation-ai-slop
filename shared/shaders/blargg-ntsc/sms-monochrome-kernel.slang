#version 450

/*
   Blargg's NTSC filter: the kernels of Genesis Plus GX's "Monochrome".

   sms_ntsc 0.2.3, Copyright (C) 2006-2007 Shay Green, GNU Lesser General Public
   License, version 2.1 or later. Written by
   shared/shaders/tools/blargg_ntsc.py; change that, not this.

   One row per burst phase (1), place of the pixel against the colour
   carrier (3) and input channel (red, green, blue): what a pixel with
   that channel at 1 adds to the 14 output samples it spreads over. A column
   of zeroes either side lets blargg-ntsc.inc read between samples.
*/

layout(push_constant) uniform Push
{
    vec4 OutputSize;
} params;

layout(std140, set = 0, binding = 0) uniform UBO
{
    mat4 MVP;
} global;

#pragma stage vertex
layout(location = 0) in vec4 Position;
layout(location = 1) in vec2 TexCoord;
layout(location = 0) out vec2 vTexCoord;

void main()
{
    gl_Position = global.MVP * Position;
    vTexCoord = TexCoord;
}

#pragma stage fragment
#pragma format R16G16B16A16_SFLOAT
layout(location = 0) in vec2 vTexCoord;
layout(location = 0) out vec4 FragColor;

const int kTaps = 14;
const int kRows = 9;

const vec3 kKernel[kRows * kTaps] = vec3[kRows * kTaps](
    // burst 0, pixel 0, red
    vec3(-0.005768, -0.005768, -0.005768),
    vec3(0.022361, 0.022361, 0.022361),
    vec3(0.001228, 0.001228, 0.001228),
    vec3(-0.054463, -0.054463, -0.054463),
    vec3(0.031248, 0.031248, 0.031248),
    vec3(0.265719, 0.265719, 0.265719),
    vec3(0.377468, 0.377468, 0.377468),
    vec3(0.213997, 0.213997, 0.213997),
    vec3(-0.007478, -0.007478, -0.007478),
    vec3(-0.042757, -0.042757, -0.042757),
    vec3(0.012087, 0.012087, 0.012087),
    vec3(0.012397, 0.012397, 0.012397),
    vec3(-0.007348, -0.007348, -0.007348),
    vec3(-0.004264, -0.004264, -0.004264),
    // burst 0, pixel 0, green
    vec3(-0.008077, -0.008077, -0.008077),
    vec3(0.015292, 0.015292, 0.015292),
    vec3(0.009091, 0.009091, 0.009091),
    vec3(-0.045533, -0.045533, -0.045533),
    vec3(0.008476, 0.008476, 0.008476),
    vec3(0.257147, 0.257147, 0.257147),
    vec3(0.483300, 0.483300, 0.483300),
    vec3(0.413972, 0.413972, 0.413972),
    vec3(0.128007, 0.128007, 0.128007),
    vec3(-0.053385, -0.053385, -0.053385),
    vec3(-0.021351, -0.021351, -0.021351),
    vec3(0.016809, 0.016809, 0.016809),
    vec3(0.003426, 0.003426, 0.003426),
    vec3(-0.008669, -0.008669, -0.008669),
    // burst 0, pixel 0, blue
    vec3(-0.004516, -0.004516, -0.004516),
    vec3(-0.000982, -0.000982, -0.000982),
    vec3(0.010457, 0.010457, 0.010457),
    vec3(-0.005271, -0.005271, -0.005271),
    vec3(-0.021384, -0.021384, -0.021384),
    vec3(0.032093, 0.032093, 0.032093),
    vec3(0.130670, 0.130670, 0.130670),
    vec3(0.150386, 0.150386, 0.150386),
    vec3(0.059128, 0.059128, 0.059128),
    vec3(-0.023704, -0.023704, -0.023704),
    vec3(-0.012733, -0.012733, -0.012733),
    vec3(0.008295, 0.008295, 0.008295),
    vec3(0.002919, 0.002919, 0.002919),
    vec3(-0.004237, -0.004237, -0.004237),
    // burst 0, pixel 1, red
    vec3(-0.007521, -0.007521, -0.007521),
    vec3(-0.002429, -0.002429, -0.002429),
    vec3(0.014552, 0.014552, 0.014552),
    vec3(-0.006118, -0.006118, -0.006118),
    vec3(-0.039291, -0.039291, -0.039291),
    vec3(0.049984, 0.049984, 0.049984),
    vec3(0.268287, 0.268287, 0.268287),
    vec3(0.353886, 0.353886, 0.353886),
    vec3(0.170061, 0.170061, 0.170061),
    vec3(-0.012928, -0.012928, -0.012928),
    vec3(-0.034353, -0.034353, -0.034353),
    vec3(0.010332, 0.010332, 0.010332),
    vec3(0.010239, 0.010239, 0.010239),
    vec3(-0.009014, -0.009014, -0.009014),
    // burst 0, pixel 1, green
    vec3(-0.014087, -0.014087, -0.014087),
    vec3(0.013943, 0.013943, 0.013943),
    vec3(0.016713, 0.016713, 0.016713),
    vec3(-0.050319, -0.050319, -0.050319),
    vec3(-0.022791, -0.022791, -0.022791),
    vec3(0.267818, 0.267818, 0.267818),
    vec3(0.598422, 0.598422, 0.598422),
    vec3(0.513882, 0.513882, 0.513882),
    vec3(0.149227, 0.149227, 0.149227),
    vec3(-0.048827, -0.048827, -0.048827),
    vec3(-0.022434, -0.022434, -0.022434),
    vec3(0.020881, 0.020881, 0.020881),
    vec3(0.001432, 0.001432, 0.001432),
    vec3(-0.012613, -0.012613, -0.012613),
    // burst 0, pixel 1, blue
    vec3(0.001271, 0.001271, 0.001271),
    vec3(0.001600, 0.001600, 0.001600),
    vec3(-0.003944, -0.003944, -0.003944),
    vec3(-0.002735, -0.002735, -0.002735),
    vec3(0.013981, 0.013981, 0.013981),
    vec3(0.031189, 0.031189, 0.031189),
    vec3(0.035160, 0.035160, 0.035160),
    vec3(0.034100, 0.034100, 0.034100),
    vec3(0.029703, 0.029703, 0.029703),
    vec3(0.013655, 0.013655, 0.013655),
    vec3(-0.002386, -0.002386, -0.002386),
    vec3(-0.003891, -0.003891, -0.003891),
    vec3(0.001444, 0.001444, 0.001444),
    vec3(0.001290, 0.001290, 0.001290),
    // burst 0, pixel 2, red
    vec3(-0.003226, -0.003226, -0.003226),
    vec3(0.003141, 0.003141, 0.003141),
    vec3(0.005089, 0.005089, 0.005089),
    vec3(0.046926, 0.046926, 0.046926),
    vec3(0.023475, 0.023475, 0.023475),
    vec3(-0.011551, -0.011551, -0.011551),
    vec3(0.175985, 0.175985, 0.175985),
    vec3(0.256957, 0.256957, 0.256957),
    vec3(0.077959, 0.077959, 0.077959),
    vec3(-0.050334, -0.050334, -0.050334),
    vec3(-0.016378, -0.016378, -0.016378),
    vec3(0.001368, 0.001368, 0.001368),
    vec3(0.005717, 0.005717, 0.005717),
    vec3(-0.002241, -0.002241, -0.002241),
    // burst 0, pixel 2, green
    vec3(-0.009694, -0.009694, -0.009694),
    vec3(-0.006934, -0.006934, -0.006934),
    vec3(0.024027, 0.024027, 0.024027),
    vec3(-0.004999, -0.004999, -0.004999),
    vec3(-0.151059, -0.151059, -0.151059),
    vec3(0.099769, 0.099769, 0.099769),
    vec3(0.502274, 0.502274, 0.502274),
    vec3(0.603523, 0.603523, 0.603523),
    vec3(0.406114, 0.406114, 0.406114),
    vec3(0.090252, 0.090252, 0.090252),
    vec3(-0.083147, -0.083147, -0.083147),
    vec3(0.008952, 0.008952, 0.008952),
    vec3(0.031731, 0.031731, 0.031731),
    vec3(-0.011560, -0.011560, -0.011560),
    // burst 0, pixel 2, blue
    vec3(-0.004250, -0.004250, -0.004250),
    vec3(0.002789, 0.002789, 0.002789),
    vec3(0.008385, 0.008385, 0.008385),
    vec3(-0.058760, -0.058760, -0.058760),
    vec3(0.008950, 0.008950, 0.008950),
    vec3(0.092652, 0.092652, 0.092652),
    vec3(0.105260, 0.105260, 0.105260),
    vec3(0.121628, 0.121628, 0.121628),
    vec3(0.081320, 0.081320, 0.081320),
    vec3(-0.030908, -0.030908, -0.030908),
    vec3(-0.005742, -0.005742, -0.005742),
    vec3(0.010455, 0.010455, 0.010455),
    vec3(-0.000776, -0.000776, -0.000776),
    vec3(-0.004560, -0.004560, -0.004560)
);

void main()
{
    ivec2 texel = ivec2(floor(vTexCoord * params.OutputSize.xy));
    int tap = texel.x - 1;
    vec3 k = vec3(0.0);
    if (tap >= 0 && tap < kTaps && texel.y >= 0 && texel.y < kRows)
        k = kKernel[texel.y * kTaps + tap];
    FragColor = vec4(k, 1.0);
}
