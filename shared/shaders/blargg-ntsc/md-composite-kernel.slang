#version 450

/*
   Blargg's NTSC filter: the kernels of Genesis Plus GX's "Composite".

   md_ntsc 0.1.2, Copyright (C) 2006-2007 Shay Green, GNU Lesser General Public
   License, version 2.1 or later. Written by
   shared/shaders/tools/blargg_ntsc.py; change that, not this.

   One row per burst phase (1), place of the pixel against the colour
   carrier (2) and input channel (red, green, blue): what a pixel with
   that channel at 1 adds to the 16 output samples it spreads over. A column
   of zeroes either side lets blargg-ntsc.inc read between samples.
*/

layout(push_constant) uniform Push
{
    vec4 OutputSize;
} params;

layout(std140, set = 0, binding = 0) uniform UBO
{
    mat4 MVP;
} global;

#pragma stage vertex
layout(location = 0) in vec4 Position;
layout(location = 1) in vec2 TexCoord;
layout(location = 0) out vec2 vTexCoord;

void main()
{
    gl_Position = global.MVP * Position;
    vTexCoord = TexCoord;
}

#pragma stage fragment
#pragma format R16G16B16A16_SFLOAT
layout(location = 0) in vec2 vTexCoord;
layout(location = 0) out vec4 FragColor;

const int kTaps = 16;
const int kRows = 6;

const vec3 kKernel[kRows * kTaps] = vec3[kRows * kTaps](
    // burst 0, pixel 0, red
    vec3(0.044993, -0.009553, 0.010936),
    vec3(0.047745, -0.030793, -0.002794),
    vec3(0.047393, -0.059050, -0.023288),
    vec3(0.076296, -0.059487, -0.016800),
    vec3(0.153845, -0.009178, 0.038379),
    vec3(0.249871, 0.065667, 0.115101),
    vec3(0.301114, 0.105236, 0.153091),
    vec3(0.266347, 0.070339, 0.113443),
    vec3(0.180235, -0.004335, 0.031686),
    vec3(0.103993, -0.059539, -0.031672),
    vec3(0.071640, -0.064694, -0.044839),
    vec3(0.067994, -0.038939, -0.025983),
    vec3(0.062326, -0.016584, -0.008934),
    vec3(0.044271, -0.010509, -0.006492),
    vec3(0.024226, -0.011550, -0.009752),
    vec3(0.012287, -0.009690, -0.009076),
    // burst 0, pixel 0, green
    vec3(-0.013738, 0.036910, 0.000325),
    vec3(-0.034178, 0.039558, -0.011608),
    vec3(-0.088522, 0.012477, -0.054760),
    vec3(-0.131143, -0.000979, -0.084040),
    vec3(-0.086539, 0.071294, -0.025159),
    vec3(0.060301, 0.240377, 0.135031),
    vec3(0.215275, 0.408589, 0.300370),
    vec3(0.248458, 0.443726, 0.339091),
    vec3(0.125817, 0.311411, 0.216180),
    vec3(-0.042135, 0.123848, 0.042197),
    vec3(-0.132214, 0.007467, -0.058495),
    vec3(-0.114634, -0.004025, -0.054282),
    vec3(-0.053832, 0.028587, -0.007533),
    vec3(-0.017391, 0.040398, 0.015885),
    vec3(-0.015176, 0.022953, 0.007241),
    vec3(-0.020199, 0.003473, -0.006049),
    // burst 0, pixel 0, blue
    vec3(0.006093, -0.000213, 0.062473),
    vec3(-0.000764, -0.008573, 0.081018),
    vec3(-0.022130, -0.030909, 0.089515),
    vec3(-0.034239, -0.043067, 0.109184),
    vec3(-0.005047, -0.012720, 0.168332),
    vec3(0.063727, 0.058407, 0.260940),
    vec3(0.124595, 0.122545, 0.335670),
    vec3(0.122749, 0.124303, 0.335299),
    vec3(0.058163, 0.063018, 0.259540),
    vec3(-0.013863, -0.006600, 0.165628),
    vec3(-0.045117, -0.036630, 0.105391),
    vec3(-0.033306, -0.024793, 0.085414),
    vec3(-0.010687, -0.003072, 0.077406),
    vec3(-0.001781, 0.004392, 0.059704),
    vec3(-0.004908, -0.000321, 0.035458),
    vec3(-0.007573, -0.004433, 0.017352),
    // burst 0, pixel 1, red
    vec3(0.046952, -0.001492, -0.008864),
    vec3(0.062139, -0.008858, -0.020581),
    vec3(0.056085, -0.041853, -0.059281),
    vec3(0.054239, -0.072904, -0.097120),
    vec3(0.108375, -0.046956, -0.078428),
    vec3(0.232818, 0.054265, 0.016019),
    vec3(0.391328, 0.152947, 0.108956),
    vec3(0.434014, 0.180598, 0.134746),
    vec3(0.339039, 0.102102, 0.060647),
    vec3(0.223461, -0.006720, -0.037789),
    vec3(0.074807, -0.068604, -0.106105),
    vec3(0.051354, -0.062868, -0.093510),
    vec3(0.061690, -0.023872, -0.047323),
    vec3(0.059085, -0.001185, -0.017988),
    vec3(0.036809, -0.003117, -0.014394),
    vec3(0.014941, -0.009928, -0.017014),
    // burst 0, pixel 1, green
    vec3(-0.009405, 0.053224, -0.038058),
    vec3(-0.045477, 0.043066, -0.086084),
    vec3(-0.111610, 0.006088, -0.165575),
    vec3(-0.130821, 0.016304, -0.198100),
    vec3(-0.025447, 0.147487, -0.104117),
    vec3(0.173915, 0.365082, 0.087604),
    vec3(0.279279, 0.530184, 0.186729),
    vec3(0.264389, 0.526250, 0.164366),
    vec3(0.078632, 0.302449, 0.000194),
    vec3(-0.107463, 0.106968, -0.172994),
    vec3(-0.127502, -0.001715, -0.180279),
    vec3(-0.083256, 0.013043, -0.122805),
    vec3(-0.023826, 0.045535, -0.051645),
    vec3(-0.004140, 0.042870, -0.022517),
    vec3(-0.012559, 0.017422, -0.023959),
    vec3(-0.017592, 0.000403, -0.024237),
    // burst 0, pixel 1, blue
    vec3(-0.003877, -0.007857, 0.044206),
    vec3(-0.006386, -0.011320, 0.063127),
    vec3(-0.007382, -0.012918, 0.087226),
    vec3(-0.007234, -0.012768, 0.113975),
    vec3(-0.008548, -0.013289, 0.137631),
    vec3(-0.012626, -0.015792, 0.153312),
    vec3(-0.020984, -0.022890, 0.203213),
    vec3(-0.022399, -0.025102, 0.213988),
    vec3(-0.027167, -0.025929, 0.189049),
    vec3(-0.019337, -0.019855, 0.191913),
    vec3(-0.014515, -0.008726, 0.111426),
    vec3(-0.014316, -0.008583, 0.085002),
    vec3(-0.012592, -0.007514, 0.061106),
    vec3(-0.009027, -0.004948, 0.042426),
    vec3(-0.005387, -0.002383, 0.028411),
    vec3(-0.003116, -0.001078, 0.017771)
);

void main()
{
    ivec2 texel = ivec2(floor(vTexCoord * params.OutputSize.xy));
    int tap = texel.x - 1;
    vec3 k = vec3(0.0);
    if (tap >= 0 && tap < kTaps && texel.y >= 0 && texel.y < kRows)
        k = kKernel[texel.y * kTaps + tap];
    FragColor = vec4(k, 1.0);
}
