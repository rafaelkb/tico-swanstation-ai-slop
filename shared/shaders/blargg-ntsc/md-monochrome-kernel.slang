#version 450

/*
   Blargg's NTSC filter: the kernels of Genesis Plus GX's "Monochrome".

   md_ntsc 0.1.2, Copyright (C) 2006-2007 Shay Green, GNU Lesser General Public
   License, version 2.1 or later. Written by
   shared/shaders/tools/blargg_ntsc.py; change that, not this.

   One row per burst phase (1), place of the pixel against the colour
   carrier (2) and input channel (red, green, blue): what a pixel with
   that channel at 1 adds to the 16 output samples it spreads over. A column
   of zeroes either side lets blargg-ntsc.inc read between samples.
*/

layout(push_constant) uniform Push
{
    vec4 OutputSize;
} params;

layout(std140, set = 0, binding = 0) uniform UBO
{
    mat4 MVP;
} global;

#pragma stage vertex
layout(location = 0) in vec4 Position;
layout(location = 1) in vec2 TexCoord;
layout(location = 0) out vec2 vTexCoord;

void main()
{
    gl_Position = global.MVP * Position;
    vTexCoord = TexCoord;
}

#pragma stage fragment
#pragma format R16G16B16A16_SFLOAT
layout(location = 0) in vec2 vTexCoord;
layout(location = 0) out vec4 FragColor;

const int kTaps = 16;
const int kRows = 6;

const vec3 kKernel[kRows * kTaps] = vec3[kRows * kTaps](
    // burst 0, pixel 0, red
    vec3(0.011093, 0.011093, 0.011093),
    vec3(-0.003183, -0.003183, -0.003183),
    vec3(-0.027856, -0.027856, -0.027856),
    vec3(-0.024321, -0.024321, -0.024321),
    vec3(0.037391, 0.037391, 0.037391),
    vec3(0.131495, 0.131495, 0.131495),
    vec3(0.186772, 0.186772, 0.186772),
    vec3(0.156200, 0.156200, 0.156200),
    vec3(0.067160, 0.067160, 0.067160),
    vec3(-0.008854, -0.008854, -0.008854),
    vec3(-0.029157, -0.029157, -0.029157),
    vec3(-0.010148, -0.010148, -0.010148),
    vec3(0.008230, 0.008230, 0.008230),
    vec3(0.008296, 0.008296, 0.008296),
    vec3(-0.000089, -0.000089, -0.000089),
    vec3(-0.003823, -0.003823, -0.003823),
    // burst 0, pixel 0, green
    vec3(0.021255, 0.021255, 0.021255),
    vec3(0.012603, 0.012603, 0.012603),
    vec3(-0.034332, -0.034332, -0.034332),
    vec3(-0.065668, -0.065668, -0.065668),
    vec3(0.005161, 0.005161, 0.005161),
    vec3(0.189827, 0.189827, 0.189827),
    vec3(0.371750, 0.371750, 0.371750),
    vec3(0.401944, 0.401944, 0.401944),
    vec3(0.253367, 0.253367, 0.253367),
    vec3(0.050834, 0.050834, 0.050834),
    vec3(-0.060892, -0.060892, -0.060892),
    vec3(-0.051821, -0.051821, -0.051821),
    vec3(0.001330, 0.001330, 0.001330),
    vec3(0.024018, 0.024018, 0.024018),
    vec3(0.010244, 0.010244, 0.010244),
    vec3(-0.006480, -0.006480, -0.006480),
    // burst 0, pixel 0, blue
    vec3(0.009225, 0.009225, 0.009225),
    vec3(0.004129, 0.004129, 0.004129),
    vec3(-0.016015, -0.016015, -0.016015),
    vec3(-0.026822, -0.026822, -0.026822),
    vec3(0.005132, 0.005132, 0.005132),
    vec3(0.078397, 0.078397, 0.078397),
    vec3(0.142413, 0.142413, 0.142413),
    vec3(0.142791, 0.142791, 0.142791),
    vec3(0.079193, 0.079193, 0.079193),
    vec3(0.005705, 0.005705, 0.005705),
    vec3(-0.026762, -0.026762, -0.026762),
    vec3(-0.016234, -0.016234, -0.016234),
    vec3(0.003988, 0.003988, 0.003988),
    vec3(0.009259, 0.009259, 0.009259),
    vec3(0.002336, 0.002336, 0.002336),
    vec3(-0.003210, -0.003210, -0.003210),
    // burst 0, pixel 1, red
    vec3(0.013767, 0.013767, 0.013767),
    vec3(0.011285, 0.011285, 0.011285),
    vec3(-0.018909, -0.018909, -0.018909),
    vec3(-0.045532, -0.045532, -0.045532),
    vec3(-0.008876, -0.008876, -0.008876),
    vec3(0.107537, 0.107537, 0.107537),
    vec3(0.227173, 0.227173, 0.227173),
    vec3(0.257653, 0.257653, 0.257653),
    vec3(0.164567, 0.164567, 0.164567),
    vec3(0.045705, 0.045705, 0.045705),
    vec3(-0.040696, -0.040696, -0.040696),
    vec3(-0.036617, -0.036617, -0.036617),
    vec3(-0.000128, -0.000128, -0.000128),
    vec3(0.016565, 0.016565, 0.016565),
    vec3(0.007559, 0.007559, 0.007559),
    vec3(-0.004258, -0.004258, -0.004258),
    // burst 0, pixel 1, green
    vec3(0.027552, 0.027552, 0.027552),
    vec3(0.003303, 0.003303, 0.003303),
    vec3(-0.057479, -0.057479, -0.057479),
    vec3(-0.071468, -0.071468, -0.071468),
    vec3(0.050820, 0.050820, 0.050820),
    vec3(0.279444, 0.279444, 0.279444),
    vec3(0.435190, 0.435190, 0.435190),
    vec3(0.430559, 0.430559, 0.430559),
    vec3(0.207282, 0.207282, 0.207282),
    vec3(0.001489, 0.001489, 0.001489),
    vec3(-0.076244, -0.076244, -0.076244),
    vec3(-0.039990, -0.039990, -0.039990),
    vec3(0.014576, 0.014576, 0.014576),
    vec3(0.024789, 0.024789, 0.024789),
    vec3(0.004420, 0.004420, 0.004420),
    vec3(-0.009384, -0.009384, -0.009384),
    // burst 0, pixel 1, blue
    vec3(0.000254, 0.000254, 0.000254),
    vec3(-0.001040, -0.001040, -0.001040),
    vec3(-0.001815, -0.001815, -0.001815),
    vec3(0.000189, 0.000189, 0.000189),
    vec3(0.005740, 0.005740, 0.005740),
    vec3(0.012739, 0.012739, 0.012739),
    vec3(0.017636, 0.017636, 0.017636),
    vec3(0.017788, 0.017788, 0.017788),
    vec3(0.006933, 0.006933, 0.006933),
    vec3(0.005556, 0.005556, 0.005556),
    vec3(0.000129, 0.000129, 0.000129),
    vec3(-0.001596, -0.001596, -0.001596),
    vec3(-0.000899, -0.000899, -0.000899),
    vec3(0.000219, 0.000219, 0.000219),
    vec3(0.000512, 0.000512, 0.000512),
    vec3(0.000129, 0.000129, 0.000129)
);

void main()
{
    ivec2 texel = ivec2(floor(vTexCoord * params.OutputSize.xy));
    int tap = texel.x - 1;
    vec3 k = vec3(0.0);
    if (tap >= 0 && tap < kTaps && texel.y >= 0 && texel.y < kRows)
        k = kKernel[texel.y * kTaps + tap];
    FragColor = vec4(k, 1.0);
}
