    vec3(0.005883, -0.007691, 0.260228),
    vec3(0.093103, 0.070904, 0.386058),
    vec3(0.071092, 0.047737, 0.386384),
    vec3(0.091486, 0.070631, 0.411512),
    vec3(0.069944, 0.053180, 0.365453),
    vec3(-0.058339, -0.070433, 0.213516),
    vec3(-0.011743, -0.024072, 0.163238),
    vec3(0.000528, -0.009266, 0.130626),
    vec3(-0.009860, -0.016959, 0.075692),
    vec3(-0.006223, -0.011205, 0.048120)
);

void main()
{
    ivec2 texel = ivec2(floor(vTexCoord * params.OutputSize.xy));
    int tap = texel.x - 1;
    vec3 k = vec3(0.0);
    if (tap >= 0 && tap < kTaps && texel.y >= 0 && texel.y < kRows)
        k = kKernel[texel.y * kTaps + tap];
    FragColor = vec4(k, 1.0);
}
