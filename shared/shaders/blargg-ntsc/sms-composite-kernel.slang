    // burst 0, pixel 1, blue
    vec3(-0.006547, -0.002585, 0.039866),
    vec3(-0.008854, -0.003670, 0.063561),
    vec3(-0.019663, -0.013557, 0.084897),
    vec3(-0.021889, -0.015490, 0.118202),
