# Blargg's NTSC filter, composite video: Snes9x's "Blargg NTSC Filter" set to
# "Composite" (snes_ntsc 0.2.2, Shay Green, LGPL 2.1 or later).

shaders = 2

# The kernels of snes_ntsc's composite preset, as a texture: 14 taps and a
# zero either side, by 3 burst phases x 3 pixel places x 3 input channels.
# The filter of this pass is the one the next reads the game with ("Original"),
# and it averages the pixels of a higher internal resolution with it.
shader0 = blargg-ntsc-composite-kernel.slang
filter_linear0 = true
scale_type0 = absolute
scale_x0 = 16
scale_y0 = 27

# The picture: every pixel of the game through its kernel.
shader1 = blargg-ntsc.slang
filter_linear1 = true
scale_type1 = viewport
